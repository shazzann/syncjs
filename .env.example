# Public URL of the live site, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://syncjs.com

# Contact form (https://resend.com). Without a key, submissions are logged in dev and rejected in production.
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=hello@syncjs.com
# Sender on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="SyncJS website <website@syncjs.com>"
